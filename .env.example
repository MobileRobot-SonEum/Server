# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올리지 않습니다.

# API 키 (쓰는 제공자 것만 있으면 됨)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# config.yaml 값을 덮어쓰는 선택 항목
# TRANSLATOR_BACKEND=api          # api | kogpt2 | local_llm | fallback
# TRANSLATOR_PROVIDER=claude      # claude | openai
# TRANSLATOR_MODEL=claude-haiku-5-5
# TRANSLATOR_TIMEOUT_S=3.0
# LOG_RAW_TEXT=false              # true면 gloss/문장 원문을 로그에 남김 (디버깅 전용)
