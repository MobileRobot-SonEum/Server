# =====================================================================
#  temi 에이전트 서버 설정 예시. 복사해서 .env로 쓰세요:  cp .env.example .env
#  .env는 git에 올리지 않습니다.
#  (base_url·모델명은 2026-11-13에 각 공식 문서에서 확인)
# =====================================================================

# ---------------------------------------------------------------------
# 교사 모드 LLM  (OpenAI 호환 Chat Completions)
# ---------------------------------------------------------------------
# [A] Ollama (로컬 노트북 또는 같은 EC2)      docs.ollama.com/api/openai-compatibility
#     api_key는 필요하지만 값은 무시됨
TEACHER_LLM__BASE_URL=http://localhost:11434/v1
TEACHER_LLM__API_KEY=ollama
TEACHER_LLM__MODEL=qwen3:14b
#     qwen3·qwen3.5·gemma4 계열 thinking 끄기: reasoning_effort=none
TEACHER_LLM__REASONING_EFFORT=none

# [B] Gemini 무료 등급                        aistudio.google.com/docs/openai
#     무료 등급 텍스트 모델 예: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite, gemini-2.5-flash-lite
#     Gemini 3 이상은 thinking을 끌 수 없음 (2.5 계열만 none 가능). 문서상 최저는 minimal이지만
#     gemini-3.8-flash는 minimal을 거부함(400, 2026-11-13 실측) → low 사용
#     gemini-3.8-flash는 혼잡으로 503(high demand)이 자주 남 → 개발 기본값은 gemini-3.6-flash (실측 동작 확인)
#     주의: 무료 등급 입력은 Google 제품 개선에 쓰일 수 있음 → 실제 아이 정보를 넣지 말 것
# TEACHER_LLM__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# TEACHER_LLM__API_KEY=여기에_Gemini_API_키
# TEACHER_LLM__MODEL=gemini-3.6-flash
# TEACHER_LLM__REASONING_EFFORT=low

# [C] Groq 무료 등급                          console.groq.com/docs/openai
#     프로덕션 모델 예: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-20b, openai/gpt-oss-120b
#     gpt-oss는 reasoning_effort low|medium|high (none 불가), llama는 비워 둘 것
# TEACHER_LLM__BASE_URL=https://api.groq.com/openai/v1
# TEACHER_LLM__API_KEY=여기에_Groq_API_키
# TEACHER_LLM__MODEL=llama-3.3-70b-versatile
# TEACHER_LLM__REASONING_EFFORT=

# 공통 옵션
TEACHER_LLM__TIMEOUT_S=25          # 호출 1번 제한(재시도 1회 별도)
TEACHER_LLM__TEMPERATURE=0.2
# auto: tools 사용, 미지원·형식 오류면 JSON 프롬프트로 대체 / native / json
TEACHER_LLM__TOOL_MODE=auto

# ---------------------------------------------------------------------
# 아이 모드 LLM  — 자체 서빙(Ollama)만 허용
# ---------------------------------------------------------------------
# Ollama 라이브러리 확인 결과(2026-11-13): qwen3(8b,14b..), qwen3.5(4b,9b..), gemma4(e4b,12b..) 는 tools·thinking 지원,
# exaone3.5(2.4b,7.8b,32b)는 tools 미지원 → 아이 모드처럼 도구를 거의 안 쓰는 곳에 적합 (tool_mode=auto면 JSON 방식으로 자동 대체)
CHILD_LLM__BASE_URL=http://localhost:11434/v1
CHILD_LLM__API_KEY=ollama
CHILD_LLM__MODEL=exaone3.5:7.8b
CHILD_LLM__REASONING_EFFORT=
CHILD_LLM__TIMEOUT_S=10

# 아이 모드 LLM이 쓸 수 있는 호스트 (쉼표 구분). 이 목록에 없으면 서버가 시작되지 않음.
# Gemini·Groq·OpenAI·ollama.com 주소는 여기에 넣어도 거부됨.
# 개발 중 노트북에서 EC2의 Ollama를 부를 때 그 주소를 추가:  localhost,127.0.0.1,3.35.xx.xx
CHILD_ALLOWED_LLM_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------
# 접근 제어: 클라이언트 역할별 API 키 (헤더 X-API-Key)
#   teacher_app → /agent/teacher, /approvals
#   temi        → /agent/child
#   rule_engine → /events
# 아래는 예시 값. 실제로는 길고 무작위인 값을 쓰세요:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------
AUTH_ENABLED=true
TEACHER_APP_API_KEY=example-teacher-app-key-change-me
TEMI_API_KEY=example-temi-key-change-me
RULE_ENGINE_API_KEY=example-rule-engine-key-change-me

# ---------------------------------------------------------------------
# 에이전트 / 로봇 실행기
# ---------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_DEADLINE_S=60            # 교사 지시 하나 전체 상한. 넘으면 "응답이 늦어지고 있어요. 다시 시도해 주세요"
CHILD_DEADLINE_S=10            # 아이 모드 LLM 단계 상한. 넘으면 기본 답변
ROBOT_EXECUTOR=mock            # mock | control(미구현 스텁)
MOCK_MOVE_DELAY_S=0.5
MOCK_FAILURE_RATE=0.0          # 0~1, 일시 실패를 일부러 일으킬 확률
MOCK_FAIL_TOOLS=               # 예: go_to,start_delivery (비우면 모든 동작이 대상)
CONTROL_WS_URL=ws://localhost:8765/control

# ---------------------------------------------------------------------
# 아이 모드 / 개인정보 / 저장소
#   아이 대화 원문은 로그·DB에 남기지 않음 (교사 알림이 생긴 문장만 teacher_alerts에 저장). 끄는 설정 없음.
# ---------------------------------------------------------------------
CHILD_SAFETY_RULES_PATH=       # 비우면 config/child_safety.yaml (위험 신호 키워드·약속 표현 목록)
CHILD_MEMORY_TURNS=3           # temi별 최근 대화 턴 수 (메모리에만, 0이면 기억 안 함)
CHILD_MEMORY_TTL_S=120         # 이 시간(초) 동안 대화가 없으면 지움
DB_PATH=temi_agent.db
TIMEZONE=Asia/Seoul

# ---------------------------------------------------------------------
# 모델 비교 평가 (python scripts/eval_models.py)
# ---------------------------------------------------------------------
EVAL_MODELS=qwen3:14b,qwen3.5:9b,gemma4:12b,exaone3.5:7.8b
EVAL_BASE_URL=                 # 비우면 CHILD_LLM__BASE_URL (Ollama)
EVAL_API_KEY=
LOG_LEVEL=INFO
